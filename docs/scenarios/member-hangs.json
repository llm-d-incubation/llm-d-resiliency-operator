{
  "title": "A member hangs",
  "page": "failures/member-hangs",
  "pods": [
    {
      "name": "pod-0",
      "uid": "a1",
      "members": {
        "m0": "serving"
      }
    },
    {
      "name": "pod-1",
      "uid": "b1",
      "members": {
        "m1": "serving"
      }
    },
    {
      "name": "pod-2",
      "uid": "c1",
      "members": {
        "m2": "serving"
      }
    },
    {
      "name": "pod-3",
      "uid": "d1",
      "members": {
        "m3": "serving"
      }
    }
  ],
  "steps": [
    {
      "title": "The group serves",
      "phase": "serving",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy"
        }
      ]
    },
    {
      "title": "m2 stops making progress",
      "note": "The others notice the step never finishes and pause. Nobody is terminal, so nothing can be removed (C1).",
      "phase": "recovering",
      "pods": {
        "pod-0": {
          "m0": "paused"
        },
        "pod-1": {
          "m1": "paused"
        },
        "pod-2": {
          "m2": "paused"
        },
        "pod-3": {
          "m3": "paused"
        }
      },
      "calls": [
        {
          "to": "driver",
          "call": "Observe(pods)",
          "out": "all paused, none terminal"
        },
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Probe"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "operation, policy checkpoint and attempted marker"
        },
        {
          "to": "driver",
          "call": "Apply(Probe: observation)",
          "out": "fails: no member answers a request"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "completed result for the next Decide"
        },
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Wait: the engine is still diagnosing"
        }
      ],
      "journal": "recovering since 10:00:00"
    },
    {
      "title": "Still waiting",
      "note": "The engine may still find the fault and report m2 terminal; then it is a member dying.",
      "phase": "recovering",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Wait"
        }
      ]
    },
    {
      "title": "--ft-diagnosis-timeout passes",
      "phase": "starting",
      "pods": {
        "pod-0": {
          "gone": true
        },
        "pod-1": {
          "gone": true
        },
        "pod-2": {
          "gone": true
        },
        "pod-3": {
          "gone": true
        }
      },
      "calls": [
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "RecreateGroup"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "operation, policy checkpoint and attempted marker"
        },
        {
          "to": "workload",
          "call": "ResetAll([pod-0 ... pod-3])",
          "in": "reason: diagnosis_deadline",
          "out": "the whole group is recreated"
        }
      ],
      "note": "75s by default, from the fault. Nothing the engine reported could be acted on."
    },
    {
      "title": "A new group serves",
      "phase": "serving",
      "pods": {
        "pod-0": {
          "uid": "a2",
          "m0": "serving"
        },
        "pod-1": {
          "uid": "b2",
          "m1": "serving"
        },
        "pod-2": {
          "uid": "c2",
          "m2": "serving"
        },
        "pod-3": {
          "uid": "d2",
          "m3": "serving"
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "Discover()",
          "out": "4 new UIDs, none saved: a new group"
        },
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy"
        }
      ]
    }
  ]
}
