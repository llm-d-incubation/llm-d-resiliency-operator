{
  "title": "A Pod is lost",
  "page": "failures/pod-lost",
  "pods": [
    {
      "name": "pod-0",
      "uid": "a1",
      "members": {
        "m0": "serving"
      }
    },
    {
      "name": "pod-1",
      "uid": "b1",
      "members": {
        "m1": "serving"
      }
    },
    {
      "name": "pod-2",
      "uid": "c1",
      "members": {
        "m2": "serving"
      }
    },
    {
      "name": "pod-3",
      "uid": "d1",
      "members": {
        "m3": "serving"
      }
    }
  ],
  "steps": [
    {
      "title": "The group serves",
      "phase": "serving",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy"
        }
      ]
    },
    {
      "title": "pod-3 is deleted",
      "note": "Its node failed, or someone deleted it. The engine may not notice yet.",
      "phase": "recovering",
      "pods": {
        "pod-0": {
          "m0": "paused"
        },
        "pod-1": {
          "m1": "paused"
        },
        "pod-2": {
          "m2": "paused"
        },
        "pod-3": {
          "gone": true,
          "m3": "dead"
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "Discover()",
          "out": "pod-3 is gone"
        },
        {
          "to": "driver",
          "call": "Observe(pods)",
          "out": "m0, m1, m2 paused · nothing from pod-3"
        }
      ],
      "journal": "m3@idD added to the observation as terminal: pod lost"
    },
    {
      "title": "A reconfig removes m3",
      "phase": "recovering",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Change: remove m3@idD"
        },
        {
          "to": "driver",
          "call": "Apply(saved operation, fresh observation)",
          "out": "Running; m0, m1, m2 accepted"
        }
      ]
    },
    {
      "title": "The group serves with 3 members",
      "phase": "serving",
      "pods": {
        "pod-0": {
          "m0": "serving"
        },
        "pod-1": {
          "m1": "serving"
        },
        "pod-2": {
          "m2": "serving"
        },
        "pod-3": {
          "m3": "excluded"
        }
      },
      "calls": [
        {
          "to": "driver",
          "call": "Apply(...)",
          "out": "Succeeded"
        },
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Verify"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "operation, policy checkpoint and attempted marker"
        },
        {
          "to": "driver",
          "call": "Apply(Verify: observation, [m0, m1, m2])",
          "out": "inference works"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "completed result for the next Decide"
        }
      ]
    },
    {
      "title": "The workload brings a replacement",
      "note": "A workload that recreates the whole group instead starts a new group.",
      "phase": "serving",
      "pods": {
        "pod-3": {
          "uid": "d2",
          "gone": false,
          "m3": "joining"
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "Discover()",
          "out": "pod-3 back with UID d2, Ready"
        },
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Change: add m3@idD2"
        }
      ]
    },
    {
      "title": "Full again",
      "phase": "serving",
      "pods": {
        "pod-3": {
          "m3": "serving"
        }
      },
      "calls": [
        {
          "to": "driver",
          "call": "Apply(...)",
          "out": "Succeeded"
        }
      ]
    }
  ]
}
