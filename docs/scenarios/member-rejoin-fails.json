{
  "title": "A replacement fails; policy preserves its retry decision",
  "page": "failures/member-rejoin-fails",
  "pods": [
    {
      "name": "pod-0",
      "uid": "a1",
      "members": {
        "m0": "serving",
        "m1": "serving",
        "m2": "serving",
        "m3": "serving"
      }
    }
  ],
  "steps": [
    {
      "title": "One member dies",
      "phase": "recovering",
      "calls": [
        {
          "to": "driver",
          "call": "Observe",
          "out": "m1@idA Terminal; container and other processes survive"
        }
      ],
      "pods": {
        "pod-0": {
          "m1": "dead"
        }
      }
    },
    {
      "title": "Policy chooses removal",
      "phase": "recovering",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Change: Remove m1@idA; policy State: stage=remove"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "operation remove-1; budget Actions=1; policy checkpoint"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "remove-1 Attempted=true before driver call"
        },
        {
          "to": "driver",
          "call": "Apply(remove-1, Attempted=false)",
          "out": "Running; removal submitted"
        }
      ]
    },
    {
      "title": "Removal completes and survivors are verified",
      "phase": "recovering",
      "calls": [
        {
          "to": "driver",
          "call": "Apply(remove-1, Attempted=true)",
          "out": "Succeeded; removal committed"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "m1 excluded; result remove-1 Succeeded"
        },
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Verify: m0, m2, m3"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "verify-1 and attempted marker"
        },
        {
          "to": "driver",
          "call": "Apply(verify-1)",
          "out": "Succeeded; survivors generated tokens"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "result verify-1 Succeeded"
        }
      ],
      "pods": {
        "pod-0": {
          "m1": "excluded"
        }
      }
    },
    {
      "title": "Observe a reserved replacement",
      "phase": "serving",
      "calls": [
        {
          "to": "driver",
          "call": "Observe",
          "out": "m1-process2@idA Joinable; Replaces m1@idA"
        }
      ],
      "pods": {
        "pod-0": {
          "m1-new": "starting"
        }
      }
    },
    {
      "title": "Policy chooses admission; driver prepares survivors",
      "phase": "serving",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Change: Add m1-process2@idA; policy State: attempt=1"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "add-1 and policy checkpoint; budget Actions=2; Attempted=true"
        },
        {
          "to": "driver",
          "call": "Apply(add-1, Attempted=false)",
          "out": "Running; Checkpoint: stage=preparing"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "add-1 execution checkpoint"
        }
      ],
      "pods": {
        "pod-0": {
          "m1-new": "joining"
        }
      },
      "note": "One immutable admission action can span many calls. Decide is not called while add-1 is pending."
    },
    {
      "title": "Driver advances the same admission action",
      "phase": "serving",
      "calls": [
        {
          "to": "driver",
          "call": "Observe",
          "out": "survivors prepared for add-1"
        },
        {
          "to": "driver",
          "call": "Apply(add-1, Attempted=true)",
          "out": "Running; reserved process launched; Checkpoint: stage=launched"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "add-1 Checkpoint=launched; budget still Actions=2"
        }
      ],
      "note": "The driver controls native cleanup and launch. It fences effects by operation and process identity."
    },
    {
      "title": "A new leader resumes add-1",
      "phase": "serving",
      "calls": [
        {
          "to": "journal",
          "call": "Load",
          "out": "add-1, Attempted=true, execution checkpoint, policy state, Actions=2"
        },
        {
          "to": "driver",
          "call": "Observe",
          "out": "replacement already launched under add-1"
        },
        {
          "to": "driver",
          "call": "Apply(add-1, Attempted=true)",
          "out": "Running; continue membership commit"
        }
      ],
      "note": "If the launch checkpoint was lost, remote readback or runtime deduplication must still prevent a duplicate launch."
    },
    {
      "title": "Admission fails with proven joiner-only effects",
      "phase": "serving",
      "calls": [
        {
          "to": "driver",
          "call": "Apply(add-1)",
          "out": "Failed, Scope=Joiners; candidate fenced, survivors unchanged"
        },
        {
          "to": "journal",
          "call": "Save",
          "out": "m1-process2@idA rejected; result add-1 Failed; policy attempt=1"
        }
      ],
      "pods": {
        "pod-0": {
          "m1-new": "excluded"
        }
      },
      "note": "A lost response alone cannot produce this report. An unknown commit stays pending."
    },
    {
      "title": "Policy sees a fresh candidate after reload",
      "phase": "serving",
      "calls": [
        {
          "to": "journal",
          "call": "Load",
          "out": "policy attempt=1; add-1 Failed; old candidate Rejected; Actions=2"
        },
        {
          "to": "driver",
          "call": "Observe",
          "out": "m1-process3@idA Joinable; Replaces m1@idA"
        },
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Healthy; policy State: consumed=add-1, attempts=1, stopped=true"
        }
      ],
      "note": "This example policy allows one admission attempt per original member. A new candidate does not reset that history."
    },
    {
      "title": "Repeated polls preserve the decision",
      "phase": "serving",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "Healthy; original m1 remains excluded"
        }
      ],
      "note": "The same result is not counted twice. A policy permitting more attempts must also remain inside the controller recovery budget."
    }
  ]
}
