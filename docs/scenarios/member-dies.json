{
  "title": "A member dies",
  "page": "failures/member-dies",
  "pods": [
    {"name": "pod-0", "uid": "a1", "members": {"m0": "serving"}},
    {"name": "pod-1", "uid": "b1", "members": {"m1": "serving"}},
    {"name": "pod-2", "uid": "c1", "members": {"m2": "serving"}},
    {"name": "pod-3", "uid": "d1", "members": {"m3": "serving"}}
  ],
  "steps": [
    {
      "title": "The group serves",
      "phase": "serving",
      "calls": [
        {"to": "workload", "call": "Discover()", "out": "4 Pods, all Ready"},
        {"to": "driver", "call": "Observe(pods)", "out": "m0 to m3 serving"},
        {"to": "policy", "call": "Decide(input)", "out": "Healthy"}
      ],
      "journal": "serving · admitted m0@idA m1@idB m2@idC m3@idD"
    },
    {
      "title": "m3 dies",
      "note": "The survivors pause and wait for an instruction.",
      "phase": "recovering",
      "pods": {"pod-0": {"m0": "paused"}, "pod-1": {"m1": "paused"}, "pod-2": {"m2": "paused"}, "pod-3": {"m3": "dead"}},
      "calls": [
        {"to": "driver", "call": "Observe(pods)", "out": "m3 terminal · m0, m1, m2 paused"},
        {"to": "policy", "call": "Decide(input)", "in": "admitted m0 to m3", "out": "Change: remove m3@idD"}
      ]
    },
    {
      "title": "IRO saves the reconfig, then sends it",
      "note": "Saved first, so a new leader knows a reconfig may be running.",
      "phase": "recovering",
      "calls": [
        {"to": "journal", "call": "Save(record)", "in": "reconfig iro-ft-1: remove m3@idD"},
        {"to": "driver", "call": "Apply(saved operation, fresh observation)", "in": "iro-ft-1 to m0, m1, m2", "out": "Running; m0, m1, m2 accepted"},
        {"to": "journal", "call": "Save(record)", "in": "Running report and execution checkpoint"}
      ],
      "journal": "recovering · reconfig iro-ft-1 accepted by m0 m1 m2"
    },
    {
      "title": "The group serves with 3 members",
      "phase": "serving",
      "pods": {"pod-0": {"m0": "serving"}, "pod-1": {"m1": "serving"}, "pod-2": {"m2": "serving"}, "pod-3": {"m3": "excluded"}},
      "calls": [
        {"to": "driver", "call": "Apply(saved operation, fresh observation)", "out": "Succeeded"},
        {"to": "policy", "call": "Decide(input)", "out": "Verify"},
        {"to": "journal", "call": "Save(record)", "out": "operation, policy checkpoint and attempted marker"},
        {"to": "driver", "call": "Apply(Verify: observation, [m0, m1, m2])", "out": "inference works"},
        {"to": "journal", "call": "Save(record)", "out": "completed result for the next Decide"}
      ],
      "journal": "serving · admitted m0 m1 m2 · excluded m3@idD"
    },
    {
      "title": "IRO resets the failed Pod",
      "note": "pod-3 holds only excluded members. This needs an engine that can grow; with one that cannot, the group serves with 3. No deadline: loading takes as long as it takes.",
      "phase": "serving",
      "pods": {"pod-3": {"uid": "d2", "m3": "starting"}},
      "calls": [
        {"to": "policy", "call": "Decide(input)", "out": "ReplaceMembers"},
        {"to": "journal", "call": "Save(record)", "out": "operation, policy checkpoint and attempted marker"},
        {"to": "workload", "call": "Reset([pod-3 d1])", "out": "pod-3 is deleted and recreated"},
        {"to": "workload", "call": "Discover()", "out": "pod-3 back with UID d2, starting"}
      ]
    },
    {
      "title": "The new member joins",
      "phase": "serving",
      "pods": {"pod-3": {"m3": "joining"}},
      "calls": [
        {"to": "driver", "call": "Observe(pods)", "out": "m3 on pod-3 (d2) joinable"},
        {"to": "policy", "call": "Decide(input)", "in": "candidate m3@idD2", "out": "Change: add m3@idD2"},
        {"to": "driver", "call": "Apply(saved operation, fresh observation)", "in": "iro-ft-2: add m3@idD2", "out": "Running; all accepted"}
      ]
    },
    {
      "title": "Full again",
      "phase": "serving",
      "pods": {"pod-3": {"m3": "serving"}},
      "calls": [
        {"to": "driver", "call": "Apply(saved operation, fresh observation)", "out": "Succeeded"},
        {"to": "policy", "call": "Decide(input)", "out": "Verify"},
        {"to": "journal", "call": "Save(record)", "out": "operation, policy checkpoint and attempted marker"},
        {"to": "driver", "call": "Apply(Verify: observation, [m0, m1, m2, m3])", "out": "inference works"},
        {"to": "journal", "call": "Save(record)", "out": "completed result for the next Decide"}
      ],
      "journal": "serving · admitted m0@idA m1@idB m2@idC m3@idD2"
    }
  ]
}
