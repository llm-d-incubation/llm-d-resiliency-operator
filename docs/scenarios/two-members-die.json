{
  "title": "Two members die",
  "page": "failures/several-members-die",
  "engines": {
    "vllm": {
      "pods": [
        {"name": "pod-0", "uid": "a1", "members": {"dp0": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}},
        {"name": "pod-1", "uid": "b1", "members": {"dp1": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}},
        {"name": "pod-2", "uid": "c1", "members": {"dp2": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}},
        {"name": "pod-3", "uid": "d1", "members": {"dp3": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}}
      ],
      "steps": [
        {
          "title": "The group serves",
          "phase": "serving",
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "pod-0 (UID a1), pod-1 (UID b1), pod-2 (UID c1), pod-3 (UID d1)"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0: Serving; dp1: Serving; dp2: Serving; dp3: Serving",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "dp0 on pod-0 (UID a1), port 8000; dp1 on pod-1 (UID b1), port 8000; dp2 on pod-2 (UID c1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"healthy\"}]"},
                {"call": "GET /health", "in": "dp0 on pod-0 (UID a1), port 8000; dp1 on pod-1 (UID b1), port 8000; dp2 on pod-2 (UID c1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "out": "Healthy"}
          ]
        },
        {
          "title": "dp1 and dp3 die together",
          "phase": "recovering",
          "pods": {"pod-0": {"dp0": {"state": "paused", "membership": "admitted", "status": "unhealthy", "health": 200}}, "pod-1": {"dp1": {"state": "dead", "membership": "admitted", "status": "healthy", "health": 503}}, "pod-2": {"dp2": {"state": "paused", "membership": "admitted", "status": "unhealthy", "health": 200}}, "pod-3": {"dp3": {"state": "dead", "membership": "admitted", "status": "healthy", "health": 503}}},
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "pod-0 (UID a1), pod-1 (UID b1), pod-2 (UID c1), pod-3 (UID d1)"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0: Serving=false, Terminal=false, Unknown=false; dp1: Terminal; dp2: Serving=false, Terminal=false, Unknown=false; dp3: Terminal",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"unhealthy\"}]"},
                {"call": "GET /health", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200"},
                {"call": "GET /v1/fault_tolerance/status", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"healthy\"}]"},
                {"call": "GET /health", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "503"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "out": "Change: remove dp1@identity-b1 and dp3@identity-d1"},
            {"to": "journal", "call": "Save(record)", "in": "phase recovering; incident opened"},
            {"to": "driver", "call": "Probe(observation)", "out": "no serving rank; no HTTP requests"}
          ]
        },
        {
          "title": "One reconfig removes both",
          "note": "One reconfig removes both terminal members.",
          "phase": "recovering",
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "pod-0 (UID a1), pod-1 (UID b1), pod-2 (UID c1), pod-3 (UID d1)"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0: Serving=false, Terminal=false, Unknown=false; dp1: Terminal; dp2: Serving=false, Terminal=false, Unknown=false; dp3: Terminal",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"unhealthy\"}]"},
                {"call": "GET /health", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200"},
                {"call": "GET /v1/fault_tolerance/status", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"healthy\"}]"},
                {"call": "GET /health", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "503"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "out": "Change: remove dp1, dp3"},
            {"to": "journal", "call": "Save(record)", "in": "reconfig iro-ft-1: remove dp1, dp3"},
            {
              "to": "driver",
              "call": "Apply(observation, reconfig)",
              "in": "iro-ft-1 to dp0, dp2",
              "out": "dp0, dp2 accept",
              "requests": [
                {"call": "POST /v1/fault_tolerance/apply", "in": "to dp0, dp2; {\"instruction\":\"scale_down\",\"request_id\":\"iro-ft-1\",\"params\":{\"removed_dp_ranks\":[1,3]}}", "out": "202 from each participant; instruction queued"}
              ]
            },
            {"to": "journal", "call": "Save(record)", "in": "acceptances of iro-ft-1"}
          ]
        },
        {
          "title": "The group serves with 2 ranks",
          "phase": "serving",
          "pods": {"pod-0": {"dp0": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}, "pod-1": {"dp1": {"state": "dead", "membership": "excluded", "status": "healthy", "health": 503}}, "pod-2": {"dp2": {"state": "serving", "membership": "admitted", "status": "healthy", "health": 200}}, "pod-3": {"dp3": {"state": "dead", "membership": "excluded", "status": "healthy", "health": 503}}},
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "pod-0 (UID a1), pod-1 (UID b1), pod-2 (UID c1), pod-3 (UID d1)"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0: Serving; dp1: Terminal; dp2: Serving; dp3: Terminal",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "dp0 on pod-0 (UID a1), port 8000; dp1 on pod-1 (UID b1), port 8000; dp2 on pod-2 (UID c1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"healthy\"}]"},
                {"call": "GET /health", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200"},
                {"call": "GET /health", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "503"}
              ]
            },
            {"to": "policy", "call": "Progress(observation, reconfig)", "out": "Succeeded"},
            {"to": "journal", "call": "Save(record)", "in": "reconfig completed; removed members excluded; phase serving; participants pending verification"},
            {
              "to": "driver",
              "call": "Verify(observation, [dp0, dp2])",
              "out": "nil (every member returned 8 completion tokens)",
              "requests": [
                {"call": "POST /v1/completions", "in": "to dp0, dp2; {\"prompt\":\"One plus one equals\",\"max_tokens\":8,\"temperature\":0,\"ignore_eos\":true}", "out": "200 from each member; usage.completion_tokens=8"}
              ]
            },
            {"to": "journal", "call": "Save(record)", "in": "verification cleared; incident closed"}
          ]
        },
        {
          "title": "Capacity stays short",
          "note": "The removed ranks keep their GPUs; the group serves with 2 until the next group. With --ft-capacity-restore=reset-all IRO resets the group instead.",
          "phase": "serving",
          "calls": [
            {"to": "workload", "call": "Discover()", "out": "pod-0 (UID a1), pod-1 (UID b1), pod-2 (UID c1), pod-3 (UID d1)"},
            {
              "to": "driver",
              "call": "Observe(pods)",
              "out": "dp0: Serving; dp1: Terminal; dp2: Serving; dp3: Terminal",
              "requests": [
                {"call": "GET /v1/fault_tolerance/status", "in": "dp0 on pod-0 (UID a1), port 8000; dp1 on pod-1 (UID b1), port 8000; dp2 on pod-2 (UID c1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "200; schema_version=1; engines[0].id=<target rank>; engines=[{\"status\":\"healthy\"}]"},
                {"call": "GET /health", "in": "dp0 on pod-0 (UID a1), port 8000; dp2 on pod-2 (UID c1), port 8000", "out": "200"},
                {"call": "GET /health", "in": "dp1 on pod-1 (UID b1), port 8000; dp3 on pod-3 (UID d1), port 8000", "out": "503"}
              ]
            },
            {"to": "policy", "call": "Plan(observation, admitted, candidates)", "out": "Healthy"},
            {"to": "driver", "call": "Capabilities()", "out": "Grow: no"},
            {"to": "journal", "call": "Save(record)", "in": "membership updated: excluded members on kept Pods become rejected"}
          ],
          "journal": "serving; admitted dp0@identity-a1 dp2@identity-c1; rejected dp1@identity-b1 dp3@identity-d1",
          "decision": "With reset-pod and Grow=false, IRO keeps Pods containing only excluded members and records those members as rejected.",
          "pods": {"pod-1": {"dp1": {"state": "dead", "membership": "rejected", "status": "healthy", "health": 503}}, "pod-3": {"dp3": {"state": "dead", "membership": "rejected", "status": "healthy", "health": 503}}}
        }
      ]
    }
  }
}
