{
  "title": "A transient fault",
  "page": "failures/transient-fault",
  "pods": [
    {"name": "pod-0", "uid": "a1", "members": {"m0": "serving"}},
    {"name": "pod-1", "uid": "b1", "members": {"m1": "serving"}},
    {"name": "pod-2", "uid": "c1", "members": {"m2": "serving"}},
    {"name": "pod-3", "uid": "d1", "members": {"m3": "serving"}}
  ],
  "steps": [
    {
      "title": "The group serves",
      "phase": "serving",
      "calls": [
        {"to": "policy", "call": "Decide(...)", "out": "Healthy"}
      ]
    },
    {
      "title": "A step fails, nobody dies",
      "note": "For example, one collective times out. Every member pauses.",
      "phase": "recovering",
      "pods": {"pod-0": {"m0": "paused"}, "pod-1": {"m1": "paused"}, "pod-2": {"m2": "paused"}, "pod-3": {"m3": "paused"}},
      "calls": [
        {"to": "driver", "call": "Observe(pods)", "out": "m0 to m3 paused, none terminal"},
        {"to": "policy", "call": "Decide(...)", "out": "Change: remove nobody, add nobody (a retry)"}
      ]
    },
    {
      "title": "IRO sends the retry",
      "phase": "recovering",
      "calls": [
        {"to": "journal", "call": "Save(record)", "in": "reconfig iro-ft-1: retry"},
        {"to": "driver", "call": "Apply(saved operation, fresh observation)", "in": "iro-ft-1 to m0 to m3", "out": "Running; all accepted"}
      ]
    },
    {
      "title": "Back to serving, no member lost",
      "note": "The policy saves the retry time in its checkpoint. A second fault within its FlapWindow selects RecreateGroup, so leader changes do not restart the retry window.",
      "phase": "serving",
      "pods": {"pod-0": {"m0": "serving"}, "pod-1": {"m1": "serving"}, "pod-2": {"m2": "serving"}, "pod-3": {"m3": "serving"}},
      "calls": [
        {"to": "driver", "call": "Apply(...)", "out": "Succeeded"},
        {"to": "policy", "call": "Decide(input)", "out": "Verify"},
        {"to": "journal", "call": "Save(record)", "out": "operation, policy checkpoint and attempted marker"},
        {"to": "driver", "call": "Apply(Verify: observation, [m0, m1, m2, m3])", "out": "inference works"},
        {"to": "journal", "call": "Save(record)", "out": "completed result for the next Decide"}
      ]
    }
  ]
}
