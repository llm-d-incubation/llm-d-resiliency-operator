{
  "title": "A member cannot be read",
  "page": "failures/member-unreadable",
  "pods": [
    {
      "name": "pod-0",
      "uid": "a1",
      "members": {
        "m0": "serving"
      }
    },
    {
      "name": "pod-1",
      "uid": "b1",
      "members": {
        "m1": "serving"
      }
    },
    {
      "name": "pod-2",
      "uid": "c1",
      "members": {
        "m2": "serving"
      }
    },
    {
      "name": "pod-3",
      "uid": "d1",
      "members": {
        "m3": "serving"
      }
    }
  ],
  "steps": [
    {
      "title": "The group serves",
      "phase": "serving",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy"
        }
      ]
    },
    {
      "title": "m2's API stops answering",
      "note": "Its engine may still run and serve. IRO cannot tell, so m2 is unknown: never serving, never terminal.",
      "phase": "recovering",
      "pods": {
        "pod-2": {
          "m2": "unknown"
        }
      },
      "calls": [
        {
          "to": "driver",
          "call": "Observe(pods)",
          "out": "m0, m1, m3 serving · m2 unknown"
        },
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy, but with m2 unknown this counts as a fault"
        }
      ]
    },
    {
      "title": "IRO will not remove what it cannot see",
      "note": "Removing m2 could break C1: the router may still send it traffic. An action that names m2 is not sent.",
      "phase": "recovering",
      "calls": [
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Wait"
        }
      ]
    },
    {
      "title": "m2 stays unknown past --ft-diagnosis-timeout",
      "phase": "starting",
      "pods": {
        "pod-0": {
          "gone": true
        },
        "pod-1": {
          "gone": true
        },
        "pod-2": {
          "gone": true
        },
        "pod-3": {
          "gone": true
        }
      },
      "calls": [
        {
          "to": "policy",
          "call": "Decide(input)",
          "out": "RecreateGroup"
        },
        {
          "to": "journal",
          "call": "Save(record)",
          "out": "operation, policy checkpoint and attempted marker"
        },
        {
          "to": "workload",
          "call": "ResetAll([pod-0 ... pod-3])",
          "in": "reason: diagnosis_deadline",
          "out": "the whole group is recreated"
        }
      ]
    },
    {
      "title": "A new group serves",
      "phase": "serving",
      "pods": {
        "pod-0": {
          "uid": "a2",
          "m0": "serving"
        },
        "pod-1": {
          "uid": "b2",
          "m1": "serving"
        },
        "pod-2": {
          "uid": "c2",
          "m2": "serving"
        },
        "pod-3": {
          "uid": "d2",
          "m3": "serving"
        }
      },
      "calls": [
        {
          "to": "workload",
          "call": "Discover()",
          "out": "4 new UIDs, none saved: a new group"
        },
        {
          "to": "policy",
          "call": "Decide(...)",
          "out": "Healthy"
        }
      ]
    }
  ]
}
